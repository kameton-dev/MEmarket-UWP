<Page
    x:Class="MEmarket_UWP.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MEmarket_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="LayoutRoot">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,16,16,24">

                <Grid x:Name="FeaturedBanner" 
                      Margin="0,0,0,16" 
                      Height="200" 
                      Tapped="FeaturedBanner_Tapped"
                      Background="Black" >
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,1000,200"/>
                    </Grid.Clip>
                    <Image x:Name="FeaturedAppImage"
                           Stretch="UniformToFill"
                           ImageFailed="FeaturedAppImage_ImageFailed"/>
                    <Border VerticalAlignment="Bottom" Height="40" Background="#B8000000" Padding="8,4,8,4">
                        <TextBlock x:Name="FeaturedAppName"
                                   Text=""
                                   Foreground="White"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>

                <!-- Состояние -->
                <Border BorderThickness="1" BorderBrush="{ThemeResource SystemControlHighlightListAccentLowBrush}" Padding="12" Margin="0,0,0,0" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE12B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="StatusText" Text="Состояние" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RepoStatusText" 
                       Text="" 
                       FontSize="11" 
                       Opacity="0.6" 
                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl x:Name="CategorySectionsList" Margin="0,20,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiLight" Margin="0,0,0,8"/>
                                <ListView ItemsSource="{Binding Apps}"
                                          IsItemClickEnabled="True"
                                          ItemClick="CategoryApp_ItemClick"
                                          SelectionMode="None"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="92" Margin="0,0,12,0">
                                                <Border Width="82"
                                                        Height="82"
                                                        Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                                        HorizontalAlignment="Left">
                                                    <Image Source="{Binding Icon}"
                                                           Width="82"
                                                           Height="82"
                                                           Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Системный индикатор загрузки всей домашней страницы -->
        <ProgressRing x:Name="LoadingRing" 
                      IsActive="True" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center" 
                      Width="50" Height="50"/>
    </Grid>
</Page>
