<Page x:Name="pageRoot"
    x:Class="MEmarket_UWP.AppPage"    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MEmarket_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="LayoutRoot">
        <Grid x:Name="ContentRoot">
            <ScrollViewer>
                <StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="AppBannerSection" Grid.Row="0" Height="202" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Visibility="Collapsed">
                            <Image x:Name="AppBannerImage"
                                   Stretch="UniformToFill" 
                                   HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                ImageFailed="AppBannerImage_ImageFailed"/>

                            <Border VerticalAlignment="Bottom" Height="80">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#B2000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <Grid x:Name="AppHeaderSection" Grid.Row="1" Margin="16,16,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="80" Height="80" Background="{ThemeResource SystemControlBackgroundAccentBrush}" VerticalAlignment="Center">
                                <Image x:Name="AppIcon" 
                                       Source="ms-appx:///Assets/StoreLogo.png" 
                                       Stretch="UniformToFill" 
                                       ImageFailed="IconImage_ImageFailed"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="AppNameText" Text="" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"/>
                                <TextBlock x:Name="PublisherText" Text="" Style="{ThemeResource BodyTextBlockStyle}" FontSize="14" Opacity="0.6"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Margin="16,0,16,24">

                        

                        <Button x:Uid="DownloadButton" x:Name="DownloadButton" Content="Скачать" Click="Download_Click" Margin="0,0,0,8" HorizontalAlignment="Left" Width="150"/>

                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" Height="5" Margin="0,0,0,8" Visibility="Collapsed"/>

                        <TextBlock x:Name="SummaryText" Text="" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Margin="0,0,0,16" FontSize="16" FontWeight="Bold"/>

                        <TextBlock x:Uid="DescriptionHeader" Text="Описание" Margin="0,0,0,8" FontSize="24" FontWeight="SemiLight"/>
                        <RichTextBlock x:Name="DescriptionText"/>
                        <HyperlinkButton x:Name="ToggleDescriptionButton" Content="Развернуть" HorizontalAlignment="Left" Click="ToggleDescriptionButton_Click" Visibility="Collapsed"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,0,0,0" Visibility="Collapsed" x:Name="ScreenshotsScrollViewer">
                            <ListView x:Name="ScreenshotsListView" Margin="0,0,0,0">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" Width="225" Height="325" Margin="0,0,8,0" Stretch="UniformToFill" Tapped="Screenshot_Tapped" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>

                        <TextBlock x:Uid="DetailsHeader" Text="ЫЫЫ" Margin="0,16,0,8" FontSize="24" FontWeight="SemiLight" SelectionChanged="TextBlock_SelectionChanged"/>

                        <ComboBox x:Name="VersionComboBox" 
                                  x:Uid="VersionComboBox"
                                  PlaceholderText="выбрать версию" 
                                  Visibility="Collapsed" 
                                  SelectionChanged="VersionComboBox_SelectionChanged"
                                  DisplayMemberPath="Version"
                                  Margin="0,0,0,8"
                                  Header="Версия:">
                        </ComboBox>
                        <TextBlock x:Name="AppVersionText" Text="" Style="{ThemeResource BodyTextBlockStyle}" Margin="0,0,0,8" FontSize="16"/>
                        <TextBlock x:Name="AppRepoText" Text=" " Style="{ThemeResource BodyTextBlockStyle}" Margin="0,0,0,8" FontSize="16"/>
                        <TextBlock x:Name="AppCategoryText" Text=" " Style="{ThemeResource BodyTextBlockStyle}" Margin="0,0,0,8" FontSize="16"/>
                        <TextBlock x:Name="AppTypeText" Text=" " Style="{ThemeResource BodyTextBlockStyle}" Margin="0,0,0,8" FontSize="16"/>


                        <TextBlock x:Uid="CapabilitiesText" x:Name="CapabilitiesText" Text="Возможности:" Style="{ThemeResource BodyTextBlockStyle}" Margin="0,0,0,8" FontSize="16" Visibility="Collapsed"/>
                        <ItemsControl x:Name="CapabilitiesList" Margin="0,0,0,16" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="• " Style="{ThemeResource BodyTextBlockStyle}"/>
                                        <TextBlock Text="{Binding}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>